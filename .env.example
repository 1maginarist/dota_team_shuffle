# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Кто может собирать команды (/game): Telegram ID через запятую.
# Свой ID можно узнать командой /id у бота. Пусто — собирать может любой.
ADMIN_IDS=

# --- Тонкая настройка балансировки (можно не трогать) ---
# Штраф (в ММР) за 1-ю, 2-ю, 3-ю, 4-ю, 5-ю роль из списка игрока.
# ROLE_PENALTIES=0,100,250,400,600
# Штраф, если игрок встал на роль, которую не выбирал.
# OFF_ROLE_PENALTY=1500
# «Другой вариант» выбирает среди вариантов не хуже лучшего на столько.
# RESHUFFLE_TOLERANCE=200
